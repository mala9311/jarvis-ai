LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Optional: the browser tools use a per-session Chromium profile so concurrent
# sessions (such as `lk agent simulate`) do not collide. Set this to a fixed path
# to reuse one profile, for example to keep a website login between runs.
# JARVIS_BROWSER_PROFILE=.browser-profile/my-profile

# Optional: set to 1 to run the agent's browser without a visible window.
# JARVIS_HEADLESS=1
